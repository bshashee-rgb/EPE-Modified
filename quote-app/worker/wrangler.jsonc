{
  "name": "epe",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "epe-quote", "database_id": "b34a06ce-1726-4a7d-adc3-6f7b1974a37e" }
  ],
  // epe-quote-attachments does NOT exist yet in the production Cloudflare account — this
  // binding is declared (matching the D1 pattern) so local `wrangler dev`/tests can emulate R2,
  // but provisioning the real bucket + deploying this to production is a separate, deliberate
  // step (see docs/DEPLOYMENT.md). Deploying before that bucket exists will fail loudly, not
  // silently — that's intentional.
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "epe-quote-attachments" }
  ],
  // Top-level config = PRODUCTION (worker `epe-quote`, prod D1). The `staging`
  // environment is a fully separate worker + D1 so client testing on staging can
  // never touch production data. `develop` auto-deploys here via deploy-staging.yml.
  "env": {
    "staging": {
      "name": "epe-quote-staging",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "epe-quote-staging", "database_id": "3f7bbd89-ca09-4d3f-9332-928a6d86688b" }
      ],
      "r2_buckets": [
        { "binding": "ATTACHMENTS", "bucket_name": "epe-quote-attachments-staging" }
      ]
    },
    // Personal sandbox — separate Cloudflare account, never pushed upstream.
    // NOTE: no r2_buckets binding here on purpose — R2 is not enabled on this account yet.
    // The Attachments tab is deployed and visible for UI placement/demo purposes, but any
    // actual upload/download call will fail (no ATTACHMENTS binding) until R2 is enabled and
    // this block is updated to match staging/production (see docs/DEPLOYMENT.md).
    "sandbox": {
      "name": "epe-quote-sandbox",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "epe-quote-sandbox", "database_id": "5d6bc2b0-d5f7-4dee-a0e2-81bfcaf01a4c" }
      ]
    }
  }
}
